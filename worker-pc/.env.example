# Copy to .env and fill in. .env is gitignored — never commit it.

API_BASE=https://cliptoaction-api.<your-subdomain>.workers.dev
SERVICE_TOKEN=the_WORKER_SERVICE_TOKEN_you_set_with_wrangler_secret_put

# tiny | base | small | medium — bigger is more accurate and slower.
# small is the floor, not a preference. Measured on a real 29-second Hinglish reel:
# base translated it in 11s but dropped words; small took 16s and kept them all;
# medium took 46s and clipped the ending. See D28.
WHISPER_MODEL=small

POLL_SECONDS=30
BATCH_SIZE=3

# 6 hours, and still a real ceiling rather than no ceiling. Past this no answer helps: the
# machine would be tied up for most of a day and the words would not fit in the column that
# holds them, so it is refused out loud rather than accepted and left to rot. See D42.
MAX_DURATION_SEC=21600

# 30 minutes. Past this the app ASKS before anything is downloaded -- how long it is, how
# long this machine will be busy, that everything else waits behind it, and that it can
# spend a whole day of an AI key. Nothing routine comes near it: the long videos actually
# saved are 11 to 18 minutes, and a warning that always appears is one nobody reads. D42.
WARN_ABOVE_SEC=1800

# As much transcript as the notebook holds for one video. Checked here, before the work and
# not after it -- a six-hour video whose words did not fit would otherwise be discovered at
# the last step, having already had three hours of this machine. D42.
MAX_TRANSCRIPT_CHARS=400000

# Past this, a video gets times written into its transcript every half minute, so a point
# can be found again in the video. Under it, a reel's transcript is one block of speech
# exactly as it has always been.
LONG_VIDEO_SEC=600

# Filling in who made the videos saved before this was recorded (D40). Metadata only --
# nothing is ever downloaded again. Runs ONLY when there is no real work, two at a time,
# with a pause between each: Facebook and Instagram will rate-limit a machine that asks
# two hundred questions in two minutes, and being blocked would cost transcription too.
CREATOR_BATCH=2
CREATOR_PAUSE_SEC=20
