# Copy to .env and fill in. .env is gitignored — never commit it.

API_BASE=https://cliptoaction-api.<your-subdomain>.workers.dev
SERVICE_TOKEN=the_WORKER_SERVICE_TOKEN_you_set_with_wrangler_secret_put

# tiny | base | small | medium — bigger is more accurate and slower.
# small is the floor, not a preference. Measured on a real 29-second Hinglish reel:
# base translated it in 11s but dropped words; small took 16s and kept them all;
# medium took 46s and clipped the ending. See D28.
WHISPER_MODEL=small

POLL_SECONDS=30
BATCH_SIZE=3
MAX_DURATION_SEC=1800
