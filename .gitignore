.env
.env.*
!.env.example

# Transient PM Discipline checklist — created per commit, consumed and deleted
# by .githooks/prepare-commit-msg. Never committed.
review_pass.json

node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Downloaded media is transient — transcribed, then deleted. Never committed.
worker-pc/media/
.wrangler/

# Assembled at deploy time from index.html; never edited by hand.
backend/.staging-assets/

# Scratch probes a reviewer or a debugging session leaves behind. They are discovered by
# `node --test` and would otherwise run in CI, printing debug output into the release gate.
*.probe.test.js

# Per-machine editor and agent state, including the local dev-server config. Nothing in
# here is part of the product.
.claude/
